# Embed Partner OS — статический веб-интерфейс (React/Vite) за nginx.
# nginx также проксирует /api на сервис api, чтобы фронтенд работал
# по одному домену без CORS.
#
# Сборка:
#   docker build -f Dockerfile.web -t embed-os-web:latest .

FROM node:22-slim AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/domain/package.json packages/domain/
RUN npm ci

COPY packages ./packages
COPY apps/web ./apps/web
RUN npm run build:packages && npm run build -w @embed-os/web

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
