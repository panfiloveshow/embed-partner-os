# Embed Partner OS — образ API и фоновых воркеров.
#
# Сборка:
#   docker build -f Dockerfile.api -t embed-os-api:latest --target runtime .
# Разовые задачи (миграции/seed) используют цель build, где есть dev-инструменты:
#   docker build -f Dockerfile.api -t embed-os-api-tools:latest --target build .
#
# Аргумент WITH_PLAYWRIGHT=1 ставит Chromium для L1-проверки видеостраниц Радара
# (увеличивает образ). При WITH_PLAYWRIGHT=0 Радар работает в режиме L0,
# а L1-детекция видео отключается переменной RADAR_L1_ENABLED=0.

# --- Сборка -----------------------------------------------------------------
FROM node:22-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/domain/package.json packages/domain/
RUN npm ci

COPY packages ./packages
COPY apps/api ./apps/api
RUN npm run build:packages \
    && npm run prisma:generate -w @embed-os/api \
    && npm run build -w @embed-os/api

ARG WITH_PLAYWRIGHT=1
# Браузеры ставятся в отдельную папку, которую рантайм всегда копирует
# (пустую при WITH_PLAYWRIGHT=0), чтобы COPY не падал.
RUN mkdir -p /opt/pw-browsers \
    && if [ "$WITH_PLAYWRIGHT" = "1" ]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends openssl ca-certificates \
      && rm -rf /var/lib/apt/lists/* \
      && npx playwright install --with-deps chromium \
      && cp -r /root/.cache/ms-playwright/. /opt/pw-browsers/; \
    fi

# --- Продакшн-зависимости ----------------------------------------------------
FROM node:22-slim AS prod-deps
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/domain/package.json packages/domain/
RUN npm ci --omit=dev

# --- Рантайм ------------------------------------------------------------------
FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PERSISTENCE_MODE=postgres \
    HOST=0.0.0.0 \
    PORT=3000

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system embedos \
    && useradd --system --gid embedos --create-home embedos

# Зависимости рантайма без dev-инструментов (Prisma CLI остаётся на этапе
# миграций — см. сервис migrate в compose.prod.yaml и docs/dependency-audit.md).
COPY --from=prod-deps /app/node_modules ./node_modules
# Сгенерированный Prisma-клиент из этапа сборки.
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/node_modules/@prisma ./node_modules/@prisma
# Артефакты сборки воркспейсов.
COPY --from=build /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=build /app/packages/domain/dist ./packages/domain/dist
COPY --from=build /app/apps/api/dist ./apps/api/dist
# package.json воркспейсов нужны для резолвинга @embed-os/* через node_modules.
COPY apps/api/package.json apps/api/
COPY packages/contracts/package.json packages/contracts/
COPY packages/domain/package.json packages/domain/

ARG WITH_PLAYWRIGHT=1
# Браузеры Chromium для L1-проверок Радара + их системные библиотеки.
COPY --from=build /opt/pw-browsers /home/embedos/.cache/ms-playwright
RUN mkdir -p /home/embedos/.cache/ms-playwright \
    && if [ "$WITH_PLAYWRIGHT" = "1" ]; then \
      ./node_modules/.bin/playwright install-deps chromium; \
    fi \
    && chown -R embedos:embedos /home/embedos /app \
    && rm -rf /var/lib/apt/lists/*
ENV PLAYWRIGHT_BROWSERS_PATH=/home/embedos/.cache/ms-playwright

USER embedos
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/v1/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/api/dist/main.js"]
