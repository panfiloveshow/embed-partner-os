PORT=3000
PERSISTENCE_MODE=memory
DATABASE_URL=postgresql://embed_os:embed_os@127.0.0.1:5432/embed_os?schema=public
PUBLIC_APP_URL=http://127.0.0.1:5173
# Список разрешённых CORS-источников через запятую (например, https://app.example.ru,https://admin.example.ru).
# Если не задан, в dev-режиме разрешаются только http://localhost:* и http://127.0.0.1:*.
CORS_ORIGINS=
AUTH_MODE=development
# Web: development для локального API или external для корпоративной auth-оболочки.
VITE_AUTH_MODE=development
# Необязательный: официальный Similarweb API для оценки визитов в день и месяц.
SIMILARWEB_API_KEY=
# Бесплатная альтернатива/резерв: глобальный ранг Tranco (tranco-list.eu) ->
# полоса месячных визитов с пометкой источника. 1 = включить.
RADAR_TRANKO_ENABLED=1
# Сколько дней кэшировать ранг домена (лимит API Tranco — 1 запрос/сек).
RADAR_TRANKO_TTL_DAYS=7
# Необязательно: DaData (бесплатный тариф) — ФИО и должность директора по
# ИНН из реквизитов сайта -> готовый ЛПР в карточке Радара. Без ключа
# работает только карточка ЕГРЮЛ (ФНС, без ключа).
DADATA_API_KEY=
# Повторное исследование активных кандидатов Радара (по умолчанию раз в 7 дней).
RADAR_RECHECK_INTERVAL_HOURS=168
RADAR_RECHECK_POLL_MS=3600000
RADAR_INSPECTION_POLL_MS=15000
RADAR_RECHECK_BATCH_SIZE=25
RADAR_RECHECK_RUN_ONCE=0
# Автоматический sourcing кандидатов Радара (worker radar-sourcing, только PERSISTENCE_MODE=postgres).
# Seed-список: домены через запятую и/или текстовый файл (по одному домену/URL в строке).
RADAR_SOURCING_SEED_URLS=
RADAR_SOURCING_SEED_FILE=
# Период цикла sourcing (по умолчанию 6 часов) и лимит новых кандидатов за цикл.
RADAR_SOURCING_POLL_MS=21600000
RADAR_SOURCING_MAX_NEW=50
RADAR_SOURCING_RUN_ONCE=0
# Режим trusted_proxy: proxy проверяет OIDC, удаляет клиентский X-Embed-Actor и записывает проверенный subject.
TRUSTED_IDENTITY_HEADER=false
# Режим oidc_jwt: API самостоятельно проверяет Bearer JWT через доверенный HTTPS JWKS.
OIDC_ISSUER=https://identity.example.invalid/
OIDC_AUDIENCE=embed-partner-os
OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_JWKS_TIMEOUT_MS=5000
PLACEMENT_MONITOR_POLL_MS=5000
PLACEMENT_MONITOR_BATCH_SIZE=10
PLACEMENT_MONITOR_LEASE_MS=60000
PLACEMENT_MONITOR_MAX_ATTEMPTS=8
PLACEMENT_MONITOR_RUN_ONCE=0
WEEKLY_REPORT_FORMULA_VERSION=weekly-v1
WEEKLY_REPORT_RUN_ONCE=0
REPORT_DIGEST_WEBHOOK_URL=https://notification-gateway.example.invalid/v1/messages
REPORT_DIGEST_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
REPORT_DIGEST_RECIPIENTS=team-lead@example.invalid
REPORT_DIGEST_POLL_MS=2000
REPORT_DIGEST_BATCH_SIZE=25
REPORT_DIGEST_TIMEOUT_MS=10000
REPORT_DIGEST_RUN_ONCE=0
SLA_MONITOR_POLL_MS=60000
SLA_MONITOR_BATCH_SIZE=200
SLA_MONITOR_RUN_ONCE=0
SLA_NOTIFICATION_WEBHOOK_URL=https://notification-gateway.example.invalid/v1/messages
SLA_NOTIFICATION_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
SLA_ESCALATION_RECIPIENTS=team-lead@example.invalid
SLA_NOTIFICATION_POLL_MS=2000
SLA_NOTIFICATION_BATCH_SIZE=25
SLA_NOTIFICATION_TIMEOUT_MS=10000
SLA_NOTIFICATION_RUN_ONCE=0

# --- Каналы доставки уведомлений ---------------------------------------------
# SLA_NOTIFICATION_CHANNEL / REPORT_DIGEST_CHANNEL: webhook (по умолчанию,
# подписанный HTTP-шлюз) или telegram (Bot API напрямую).
# Для telegram нужны TELEGRAM_BOT_TOKEN и chat_id соответствующего канала.
SLA_NOTIFICATION_CHANNEL=
REPORT_DIGEST_CHANNEL=
TELEGRAM_BOT_TOKEN=
SLA_NOTIFICATION_TELEGRAM_CHAT_ID=
REPORT_DIGEST_TELEGRAM_CHAT_ID=

# --- Публикация outbox-событий (воркер outbox-relay) -------------------------
# HTTPS-эндпоинт приёмника событий и секрет HMAC-подписи (>=32 символов).
OUTBOX_PUBLISH_URL=
OUTBOX_PUBLISH_SECRET=
OUTBOX_RELAY_POLL_MS=5000
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_TIMEOUT_MS=10000
OUTBOX_RELAY_RUN_ONCE=0

# --- Развёртывание ----------------------------------------------------------
# Адрес, который слушает API. 127.0.0.1 для локальной разработки;
# в Docker/продакшене (compose.prod.yaml) используется 0.0.0.0.
HOST=
# Порт веб-интерфейса в продакшн-стеке (nginx проксирует /api на api-сервис).
WEB_PORT=8080
# Собирать Chromium внутрь образа API/воркеров для L1-детекции видео в Радаре.
# 1 = полная функциональность Радара (образ крупнее), 0 = компактный образ,
# тогда задайте RADAR_L1_ENABLED=0, чтобы Радар работал только в режиме L0.
WITH_PLAYWRIGHT=1
# Обработка пользовательских проверок Радара прямо в процессе API
# (только PERSISTENCE_MODE=postgres). 0 = отдать очередь выделенному воркеру.
RADAR_INLINE_INSPECTION=1

# --- Встроенная аутентификация (вход по логину/паролю) ----------------------
# Включается значением AUTH_MODE из константы AUTH_MODE_LOCAL_PASSWORD
# (apps/api/src/auth/auth-base.ts): API сам выдаёт и проверяет сессии HS256.
# Требуется секрет длиной не менее 32 символов.
AUTH_MODE=
LOCAL_AUTH_SECRET=
# Необязательно: администратор, создаваемый/обновляемый на старте
# (идемпотентно; существующая учётная запись получает пароль без смены роли).
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
